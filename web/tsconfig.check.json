{
  // Type-check the source only. The main tsconfig also includes Next's
  // generated files under .next/ (next-env.d.ts imports one of them), which
  // a running dev server rewrites and can leave half-written — `tsc` then
  // fails for reasons unrelated to the code. Use: npm run typecheck
  "extends": "./tsconfig.json",
  "include": ["typecheck-env.d.ts", "src/**/*.ts", "src/**/*.tsx"],
  "exclude": ["node_modules", ".next"]
}
