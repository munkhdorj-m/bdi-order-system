# ============================================================
# BDI Захиалга — environment variables
# ============================================================
# Copy this file to `.env.local` for local development, or paste each
# key/value into Vercel → Project Settings → Environment Variables
# when deploying. Values come from each provider's dashboard.
# ============================================================


# ---- REQUIRED — the app won't start without these ---------------

# Supabase project URL + anon key.
# https://app.supabase.com → your project → Project Settings → API
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key-here

# Service-role key. Bypasses RLS — used by the notify fan-out lib
# and the phone-verify register flow to create users with verified phones.
# Mark "Sensitive" in Vercel. NEVER commit this.
SUPABASE_SERVICE_ROLE_KEY=


# ---- RECOMMENDED — feature degrades without these ---------------

# Public URL where the deployed app lives — used by verify.mn callbacks
# and any external links. Defaults to http://localhost:3000 if unset.
# In production this MUST be the real domain (no trailing slash).
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# ---- Contact & social links -----------------------------------
# Shown on the buyer "Холбоо барих" tab, the login footer, and the
# pending / inactive gate screens. Leave any blank to hide that one row
# (the whole block hides if all are blank). Links accept a full URL OR a
# bare handle/domain — both "https://facebook.com/bdi" and "bdi" work.

# Main phone (also used by the order-detail "call us" link). Defaults to
# a placeholder if unset.
NEXT_PUBLIC_BDI_SUPPORT_PHONE=+976 90091109

# Facebook page — full URL or page name.
NEXT_PUBLIC_BDI_FACEBOOK=

# Instagram — full URL or @handle.
NEXT_PUBLIC_BDI_INSTAGRAM=

# Website — full URL or domain (e.g. bdi.mn).
NEXT_PUBLIC_BDI_WEBSITE=

# Physical address — shown as a row that opens Google Maps on tap.
NEXT_PUBLIC_BDI_ADDRESS=


# ---- REQUIRED for phone verification (verify.mn, Mongolia) ------
# verify.mn is a Mongolia-only Mobile-Originated SMS verification
# service. The user sends a code FROM their phone TO shortcode 144773,
# and verify.mn pings our callback when matched. Get a key at the
# verify.mn dashboard. Without this set the register flow can't
# create verification sessions.
#
# Per-verification cost (user pays the operator): 150₮.
# Developer credit per verified phone: 40₮.
VERIFY_MN_API_KEY=
