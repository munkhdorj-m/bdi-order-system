# ============================================================
# BDI Захиалга — environment variables
# ============================================================
# Copy this file to `.env.local` for local development, or paste each
# key/value into Vercel → Project Settings → Environment Variables
# when deploying. Values come from each provider's dashboard.
# ============================================================


# ---- REQUIRED — the app won't start without these ---------------

# Supabase project URL + anon key.
# https://app.supabase.com → your project → Project Settings → API
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key-here

# Service-role key. Bypasses RLS — used by the notify fan-out lib
# and the phone-OTP register flow to create users with verified phones.
# Mark "Sensitive" in Vercel. NEVER commit this.
SUPABASE_SERVICE_ROLE_KEY=


# ---- RECOMMENDED — feature degrades without these ---------------

# Public URL where the deployed app lives — used by email links and
# OAuth callback redirects. Defaults to http://localhost:3000 if unset.
# In production this MUST be the real domain (no trailing slash).
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Resend API key for new-order email notifications. Server-only (do NOT
# prefix with NEXT_PUBLIC_). Without this the app still works — emails
# get logged to the server console instead of sent.
# Get one at https://resend.com → Settings → API Keys.
RESEND_API_KEY=

# Comma-separated list of emails to notify when a new order is placed.
# Leave blank to disable. Example: ops@bdi.mn,manager@bdi.mn
ORDER_NOTIFY_EMAILS=

# Sender address for outgoing emails. Must be on a domain you've
# verified at https://resend.com/domains. For testing without a
# verified domain, use Resend's sandbox sender (sends only to your
# Resend account email): onboarding@resend.dev
ORDER_NOTIFY_FROM=onboarding@resend.dev

# Public-facing BDI support number shown on the buyer order detail
# page so buyers can call about a delivery. Defaults to a placeholder.
NEXT_PUBLIC_BDI_SUPPORT_PHONE=+976 7000 0000


# ---- OPTIONAL — phone OTP register (Mobicom SMS, Mongolia) ------
# Leave commented until you sign a Mobicom contract. Without these set,
# the phone register flow fails at the OTP send step — the email
# register flow keeps working.
#
# MOBICOM_API_URL=https://...
# MOBICOM_API_USER=...
# MOBICOM_API_KEY=...
# MOBICOM_SENDER=BDI


