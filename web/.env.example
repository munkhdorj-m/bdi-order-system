NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key-here

# Public URL the app is reachable at — used in outgoing emails so links work.
# For local dev this is http://localhost:3000.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Resend HTTP API key for new-order notifications (server-only — do NOT prefix
# with NEXT_PUBLIC_). Leave blank to disable email notifications.
RESEND_API_KEY=

# Comma-separated list of emails to notify when a new order is placed.
# Leave blank to disable. Example: ops@bdi.mn,manager@bdi.mn
ORDER_NOTIFY_EMAILS=

# Sender address for outgoing emails. Must be on a domain you've verified at
# resend.com/domains. For testing without a verified domain, use the Resend
# sandbox sender (sends only to your Resend account email):
#   onboarding@resend.dev
ORDER_NOTIFY_FROM=onboarding@resend.dev

# Service-role key from Supabase → Project Settings → API. ONLY used by
# scripts/ for one-off bulk operations. NEVER commit and never put this key
# anywhere it can leak — it bypasses every RLS rule.
SUPABASE_SERVICE_ROLE_KEY=
