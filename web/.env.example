# ============================================================
# BDI Захиалга — environment variables
# ============================================================
# Copy this file to `.env.local` for local development, or paste each
# key/value into Vercel → Project Settings → Environment Variables
# when deploying. Values come from each provider's dashboard.
# ============================================================


# ---- REQUIRED — the app won't start without these ---------------

# Supabase project URL + anon key.
# https://app.supabase.com → your project → Project Settings → API
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key-here

# Service-role key. Bypasses RLS — used by the notify fan-out lib
# and the phone-verify register flow to create users with verified phones.
# Mark "Sensitive" in Vercel. NEVER commit this.
SUPABASE_SERVICE_ROLE_KEY=


# ---- RECOMMENDED — feature degrades without these ---------------

# Public URL where the deployed app lives — used by verify.mn callbacks
# and any external links, including the button under each Telegram alert
# (which falls back to Vercel's production domain when this is unset or
# local). Defaults to http://localhost:3000 if unset.
# In production this MUST be the real domain (no trailing slash).
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# ---- Contact & social links -----------------------------------
# Shown on the buyer "Холбоо барих" tab, the login footer, and the
# pending / inactive gate screens. Leave any blank to hide that one row
# (the whole block hides if all are blank). Links accept a full URL OR a
# bare handle/domain — both "https://facebook.com/bdi" and "bdi" work.

# Main phone (also used by the order-detail "call us" link). Defaults to
# a placeholder if unset.
NEXT_PUBLIC_BDI_SUPPORT_PHONE=+976 90091109

# Facebook page — full URL or page name.
NEXT_PUBLIC_BDI_FACEBOOK=

# Instagram — full URL or @handle.
NEXT_PUBLIC_BDI_INSTAGRAM=

# Website — full URL or domain (e.g. bdi.mn).
NEXT_PUBLIC_BDI_WEBSITE=

# Physical address — shown as a row that opens Google Maps on tap.
NEXT_PUBLIC_BDI_ADDRESS=


# ---- REQUIRED for phone verification (verify.mn, Mongolia) ------
# verify.mn is a Mongolia-only Mobile-Originated SMS verification
# service. The user sends a code FROM their phone TO shortcode 144773,
# and verify.mn pings our callback when matched. Get a key at the
# verify.mn dashboard. Without this set the register flow can't
# create verification sessions.
#
# Per-verification cost (user pays the operator): 150₮.
# Developer credit per verified phone: 40₮.
VERIFY_MN_API_KEY=


# ---- Push notifications (Web Push / VAPID) ---------------------
# FREE and unlimited — no third-party account, no per-message cost.
# We sign each push with our own keypair and hand it to whatever push
# service the browser picked (FCM for Chrome/Android, Apple for iOS
# Safari, Mozilla for Firefox). Payloads are end-to-end encrypted, so
# the push service relays ciphertext it can't read.
#
# Generate a keypair once, then paste both values here AND into Vercel:
#   npx web-push generate-vapid-keys
#
# Leaving these blank disables push cleanly — the in-app bell and
# Telegram keep working, and the toggle UI reports "unsupported".
#
# Device support, so you know what to tell admins:
#   Android Chrome / desktop Chrome, Edge, Firefox — works immediately.
#   iPhone (iOS 16.4+) — ONLY after "Share → Add to Home Screen".
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
# Contact address the push services use to reach you about problems.
VAPID_SUBJECT=mailto:admin@bdi.mn


# ---- Telegram admin alerts -------------------------------------
# FREE and unlimited. The reliable half of admin alerting: unlike Web
# Push it needs no Home Screen install on iPhone and the OS keeps the
# Telegram app alive, so alerts land on the lock screen even if the
# PWA hasn't been opened in weeks.
#
# Setup (~2 minutes, once):
#   1. Message @BotFather on Telegram → /newbot → copy the token below.
#   2. Create a group, add the bot to it, send any message in the group.
#   3. Open https://api.telegram.org/bot<TOKEN>/getUpdates and copy the
#      negative `chat.id` value below.
#
# TELEGRAM_CHAT_ID accepts a comma-separated list, so you can target a
# staff group AND individual admins without code changes.
# Leaving these blank disables Telegram cleanly.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
